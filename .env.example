# Used by the root docker-compose.yml. Copy to .env and fill in.

# Required: at least 16 characters, e.g. `openssl rand -hex 32`
JWT_ACCESS_SECRET=

# Public URL of the web client (used for CORS, email links and the OAuth redirect)
FRONTEND_URL=http://localhost:8080

POSTGRES_DB=taskflow_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Optional integrations. The API starts without them; the related feature is disabled
# (Google sign in) or fails gracefully (email, attachments).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=TaskFlow <noreply@example.com>
